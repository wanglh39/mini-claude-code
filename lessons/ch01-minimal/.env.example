# === LLM API 配置 ===

# API Key（必填）
# Anthropic: sk-ant-xxx
# DeepSeek:  sk-xxx
API_KEY=

# 可选：切换 API 后端
# 留空 = Anthropic 官方
# DeepSeek: https://api.deepseek.com/anthropic
BASE_URL=

# 模型名称（必填）
# Anthropic: claude-sonnet-4-20250514
# DeepSeek:  deepseek-chat
MODEL=claude-sonnet-4-20250514

# 可选：最大 token 数
MAX_TOKENS=1024