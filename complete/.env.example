# === LLM API 配置 ===

# API Key（必填）
# Anthropic: sk-ant-xxx
# DeepSeek:  sk-xxx
API_KEY=

# 可选：切换 API 后端
# 留空 = Anthropic 官方
# DeepSeek: https://api.deepseek.com/anthropic
BASE_URL=

# 模型名称（必填）
# Anthropic: claude-sonnet-4-20250514
# DeepSeek:  deepseek-chat
MODEL=claude-sonnet-4-20250514

# 可选：最大输出 token 数
MAX_TOKENS=4096

# 可选：上下文窗口限制
CONTEXT_LIMIT=200000

# 可选：自动批准所有操作（跳过确认，危险但方便）
AUTO_APPROVE=false